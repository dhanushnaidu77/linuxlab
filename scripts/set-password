#!/usr/bin/env node
// Prompts for a console password and writes its bcrypt hash (plus a session secret) into .env
import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';
import readline from 'node:readline';
import bcrypt from 'bcryptjs';
import { ROOT, parseDotEnv } from '../server/config.js';

// usage: scripts/set-password            (prompts)
//        scripts/set-password --generate (random password, printed once — for non-interactive shells)
const envFile = path.join(ROOT, '.env');
let pw;
if (process.argv.includes('--generate')) {
  pw = crypto.randomBytes(12).toString('base64url');
} else {
  if (!process.stdin.isTTY) { console.error('No terminal to prompt on. Use: scripts/set-password --generate'); process.exit(1); }
  const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
  rl._writeToOutput = (s) => { if (!rl.muted) rl.output.write(s); };
  const ask = (q) => new Promise((res) => { rl.output.write(q); rl.muted = true; rl.question('', (a) => { rl.muted = false; rl.output.write('\n'); res(a); }); });
  pw = await ask('New console password: ');
  const again = await ask('Repeat: ');
  rl.close();
  if (!pw || pw !== again) { console.error('Passwords empty or do not match.'); process.exit(1); }
}

const existing = fs.existsSync(envFile) ? parseDotEnv(fs.readFileSync(envFile, 'utf8')) : {};
existing.LAB_PASSWORD_HASH = bcrypt.hashSync(pw, 12);
existing.SESSION_SECRET ||= crypto.randomBytes(32).toString('hex');
fs.writeFileSync(envFile, Object.entries(existing).map(([k, v]) => `${k}='${v}'`).join('\n') + '\n', { mode: 0o600 });
console.log(`Saved to ${envFile}`);
if (process.argv.includes('--generate')) console.log(`Console password: ${pw}\n(change it any time by running scripts/set-password in a real terminal)`);
